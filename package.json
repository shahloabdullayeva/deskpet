{
  "name": "deskpet",
  "version": "0.1.0",
  "private": true,
  "description": "A little 3D anime desk pet that chats, remembers things and checks in during the work day.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=20"
  },
  "productName": "Maomao",
  "author": "deskpet",
  "build": {
    "appId": "io.github.shahloabdullayeva.deskpet",
    "productName": "Maomao",
    "files": [
      "src/**",
      "electron/**",
      "me.example/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Maomao-Setup.exe",
      "shortcutName": "Maomao"
    },
    "portable": {
      "artifactName": "Maomao-Portable.exe"
    },
    "publish": null,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/icon.png",
      "category": "Utility",
      "executableName": "maomao",
      "synopsis": "A little 3D desk pet",
      "maintainer": "Shahlo Abdullayeva <266842396+shahloabdullayeva@users.noreply.github.com>"
    },
    "appImage": {
      "artifactName": "Maomao.AppImage"
    },
    "deb": {
      "artifactName": "maomao.deb"
    }
  },
  "homepage": "https://github.com/shahloabdullayeva/deskpet",
  "desktopName": "maomao.desktop"
}
